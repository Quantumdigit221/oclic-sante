{
  "name": "o-clic-sante",
  "private": true,
  "version": "1.0.0",
  "description": "O'CLIC SANTE - Plateforme de gestion médicale complète (Monorepo)",
  "author": "O'CLIC SANTE",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "monolithique"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace=@o-clic-sante/frontend",
    "dev:backend": "npm run dev --workspace=@o-clic-sante/backend",
    "build": "npm run build --workspaces",
    "build:frontend": "npm run build --workspace=@o-clic-sante/frontend",
    "build:backend": "npm run build --workspace=@o-clic-sante/backend",
    "start": "node index.js",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces",
    "install:prod": "npm install --production",
    "electron": "npm run electron --workspace=@o-clic-sante/frontend",
    "electron-dev": "concurrently \"npm run dev\" \"npm run electron --workspace=@o-clic-sante/frontend\"",
    "electron-build": "npm run build && npm run electron-build --workspace=@o-clic-sante/frontend"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/inference": "^4.13.9",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "^7.0.1-beta.21",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.24.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/jspdf": "^1.3.3",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "express": "^5.2.1",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.555.0",
    "mysql2": "^3.16.0",
    "pg": "^8.11.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.5.1",
    "sequelize": "^6.37.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^3.0.1",
    "sequelize-cli": "^6.6.5",
    "typescript": "~5.8.2",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.oclicsante.app",
    "productName": "O'CLIC SANTE",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public-electron/**/*",
      "public/LOGO.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/LOGO.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "nodeGypRebuild": false
  }
}