{
  "name": "@o-clic-sante/frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "public-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron public-electron/main.js",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3004 && electron public-electron/main.js\"",
    "electron-build": "npm run build && electron-builder --win --x64"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@huggingface/inference": "^4.13.9",
    "@mui/icons-material": "^7.3.7",
    "@mui/lab": "^7.0.1-beta.21",
    "@mui/material": "^7.3.7",
    "@mui/x-data-grid": "^8.24.0",
    "@supabase/supabase-js": "^2.86.0",
    "@types/jspdf": "^1.3.3",
    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.6.2",
    "date-fns": "^4.1.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.5.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.23",
    "concurrently": "^9.2.1",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "electron-is-dev": "^3.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.0",
    "terser": "^5.46.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.oclicsante.app",
    "productName": "O'CLIC SANTE",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "public-electron/**/*",
      "public/LOGO.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/LOGO.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "nodeGypRebuild": false
  }
}
