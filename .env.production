# Configuration Base de données MySQL Hostinger
DB_HOST=localhost
DB_PORT=3306
DB_NAME=votre_nom_de_base
DB_USER=votre_utilisateur_mysql
DB_PASSWORD=votre_mot_de_passe_mysql

# Configuration API
NODE_ENV=production
PORT=3001
API_BASE_URL=https://sante.quantum221.com/api

# Configuration Application
VITE_APP_NAME=Sénégal Santé SaaS
VITE_APP_URL=https://sante.quantum221.com

# Clés API (optionnel)
GEMINI_API_KEY=votre_cle_gemini_ici

# Sécurité
JWT_SECRET=votre_secret_jwt_tres_long_et_securise

# Configuration Email (optionnel)
SMTP_HOST=smtp.sante.quantum221.com
SMTP_PORT=587
SMTP_USER=noreply@sante.quantum221.com
SMTP_PASSWORD=votre_mot_de_passe_email
