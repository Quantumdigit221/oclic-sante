# Configuration pour l'intégration IA réelle
# Copiez ce fichier en .env.local et ajoutez vos vraies clés

# Mode de fonctionnement de l'IA
# true = API réelle (Hugging Face)
# false = Simulation (mode démo)
REACT_APP_USE_REAL_AI=false

# Configuration Hugging Face - GRATUIT et modèles médicaux spécialisés
REACT_APP_HUGGINGFACE_API_KEY=votre_cle_huggingface_ici
REACT_APP_HUGGINGFACE_MODEL=stanford-crfm/chexnet

# Configuration Google DeepMind / Vertex AI (alternative)
# REACT_APP_DEEPMIND_API_KEY=votre_clé_api_ici
# REACT_APP_DEEPMIND_PROJECT_ID=votre_projet_id_ici
# REACT_APP_DEEPMIND_LOCATION=us-central1
# REACT_APP_DEEPMIND_MODEL=gemini-1.5-pro-vision

# Configuration OpenAI (alternative)
# REACT_APP_OPENAI_API_KEY=sk-votre_clé_openai_ici
# REACT_APP_OPENAI_MODEL=gpt-4-vision-preview

# Configuration alternative - Google Cloud Vision
# REACT_APP_GOOGLE_CLOUD_KEY_FILE=path/to/service-account.json
# REACT_APP_GOOGLE_CLOUD_PROJECT=votre_projet

# Configuration alternative - Azure Cognitive Services
# REACT_APP_AZURE_VISION_KEY=votre_clé_azure
# REACT_APP_AZURE_VISION_ENDPOINT=votre_endpoint_azure

# Configuration du service personnalisé
# REACT_APP_CUSTOM_AI_API_URL=https://votre-api.com/analyze
# REACT_APP_CUSTOM_AI_API_KEY=votre_clé_personnalisée

# Configuration générale
REACT_APP_AI_TIMEOUT=30000
REACT_APP_AI_MAX_RETRIES=3
REACT_APP_AI_CONFIDENCE_THRESHOLD=0.7

# Logging et monitoring
REACT_APP_AI_LOG_LEVEL=info
REACT_APP_AI_ANALYTICS_ENABLED=true
