# ============================================
# O'CLIC SANTE — variables d'environnement (PRODUCTION HOSTINGER)
# ============================================

# --- Node ---
NODE_ENV=production
PORT=3000

# --- JWT (obligatoire en prod : >= 32 caractères aléatoires) ---
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS

# --- Application / CORS ---
APP_NAME=O'CLIC SANTE
APP_URL=https://santesaas.samacaisse.cloud
FRONTEND_URL=https://santesaas.samacaisse.cloud
# EXTRA_CORS_ORIGINS=https://www.samacaisse.cloud
TENANT_HEADER=x-tenant-id
DEFAULT_TENANT_ID=center-001
ALLOW_SUPERADMIN_CROSS_TENANT=false
REQUEST_LOGS_ENABLED=false
API_CACHE_TTL_MS=5000

# --- MySQL (Hostinger) ---
# Renseigner l'hôte exact fourni dans hPanel (ex: mysql123.hostinger.com)
DB_HOST=REPLACE_WITH_HOSTINGER_DB_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_DB_NAME
DB_USER=REPLACE_WITH_DB_USER
DB_PASSWORD=REPLACE_WITH_DB_PASSWORD
# Si la connexion MySQL exige SSL côté Hostinger : mettre true
DB_SSL=false

# --- E-mail (optionnel) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
